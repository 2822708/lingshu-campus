    {
      "id": "equipment-formula",
      "expected": {
        "ordinaryAttack": 100,
        "rareAttack": 150,
        "natalRareAttack": 225
      },
      "observed": {
        "ordinaryAttack": 100,
        "rareAttack": 150,
        "natalRareAttack": 225
