      "note": "Direct helper probe; successful diagnosis is not a system health result."
    },
    {
      "id": "equip-unequip-roundtrip",
      "expected": 10,
      "observed": 10,
      "note": "Ordinary non-natal roundtrip restores attack."
    },
    {
      "id": "repeat-equip-not-idempotent",
      "expected": 10,
      "observed": 110,
      "note": "Direct handler double-call; UI normally hides equip once worn, but handler has no same-slot idempotence check."
    },
    {
      "id": "natal-hp-drift",
      "expected": {
        "afterEquip": 600,
        "afterRefine": 600,
        "afterUnequip": 450
